[Unit]
Description=Kondo - keeps the media server tidy
Documentation=https://github.com/samjwalsh/kondo

[Service]
Type=simple
WorkingDirectory=%h/kondo
EnvironmentFile=%h/kondo/config/kondo.env
# node:sqlite still prints an "experimental" warning on every start.
ExecStart=%h/kondo/node/bin/node --disable-warning=ExperimentalWarning %h/kondo/current/server/main.mjs
Restart=always
RestartSec=5
# Also stops any ffmpeg Kondo started.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
