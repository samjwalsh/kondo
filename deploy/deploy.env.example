# Copy to deploy/deploy.env (git-ignored) and adjust.

# SSH target of the machine that runs Kondo (key-based SSH, no sudo needed).
DEPLOY_HOST=user@plex-vm.lan

# Port Kondo listens on there.
KONDO_PORT=4242

# Node version Kondo installs for itself on that machine (the system Node is left alone).
NODE_VERSION=v24.22.1
